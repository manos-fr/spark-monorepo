# =============================================================================
# SPARK MONOREPO - ENVIRONMENT VARIABLES
# =============================================================================
# This file documents all environment variables used across the monorepo.
# Copy the relevant .env.example files to .env in each directory.
#
# IMPORTANT: Never commit .env files with real secrets to git!
# =============================================================================

# -----------------------------------------------------------------------------
# DIRECTORY: apps/ui/
# PURPOSE: React Native/Expo mobile & web application
# FILE: apps/ui/.env
# -----------------------------------------------------------------------------

# Firebase Authentication (from Firebase Console)
# EXPO_PUBLIC_API_KEY=your_firebase_api_key
# EXPO_PUBLIC_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_PROJECT_ID=your-project-id
# EXPO_PUBLIC_STORAGE_BUCKET=your-project.appspot.com
# EXPO_PUBLIC_MESSAGING_SENDER_ID=123456789
# EXPO_PUBLIC_APP_ID=1:123456789:web:abcdef
# EXPO_PUBLIC_MEASUREMENT_ID=G-XXXXXXXXXX

# Hasura GraphQL Endpoints
# EXPO_PUBLIC_HASURA_ENDPOINT_PROD=https://your-instance.hasura.app/v1/graphql
# EXPO_PUBLIC_HASURA_ENDPOINT_EMULATOR=http://localhost:8083/v1/graphql
# EXPO_PUBLIC_HASURA_ENDPOINT_DEVICE=http://10.0.2.2:8083/v1/graphql

# -----------------------------------------------------------------------------
# DIRECTORY: apps/functions/
# PURPOSE: Firebase Cloud Functions
# FILE: apps/functions/.env
# -----------------------------------------------------------------------------

# Hasura connection for server-side operations
# HASURA_GRAPHQL_URL=https://your-instance.hasura.app/v1/graphql
# HASURA_GRAPHQL_ADMIN_SECRET=your_admin_secret

# -----------------------------------------------------------------------------
# DIRECTORY: infrastructure/
# PURPOSE: Local Docker development (PostgreSQL + Hasura)
# FILE: infrastructure/.env
# -----------------------------------------------------------------------------

# Local Hasura admin secret
# HASURA_ADMIN_SECRET=your_local_secret

# JWT validation for Firebase tokens
# HASURA_GRAPHQL_JWT_SECRET='{"type":"RS256",...}'

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy environment files:
#    cp apps/ui/.env.example apps/ui/.env
#    cp apps/functions/.env.example apps/functions/.env
#    cp infrastructure/.env.example infrastructure/.env
#
# 2. Get Firebase credentials:
#    - Go to https://console.firebase.google.com
#    - Select your project → Project Settings → General
#    - Scroll to "Your apps" → Select web app → Copy config values
#
# 3. Get Hasura credentials:
#    - For local dev: Use any secret you want
#    - For production: Go to Hasura Cloud dashboard → Project Settings
#
# 4. Start development:
#    npm run infra          # Start local PostgreSQL + Hasura
#    npm run update-schema  # Apply database migrations
#    npm start              # Start Expo development server
#
# =============================================================================
