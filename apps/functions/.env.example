# Hasura GraphQL Configuration for Firebase Functions
# These are used by Cloud Functions to communicate with Hasura

# Your Hasura GraphQL endpoint
HASURA_GRAPHQL_URL=https://your-hasura-instance.hasura.app/v1/graphql

# Admin secret for Hasura (keep this secure!)
# Generate a strong secret: openssl rand -base64 32
HASURA_GRAPHQL_ADMIN_SECRET=your_hasura_admin_secret_here
