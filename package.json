  "scripts": {
    "start": "npx nx start ui",
    "build": "nx build",
    "lint": "nx lint",
    "delete-users": "nx delete firebase-admin",
    "sample-data": "nx serve sample-data",
    "main-server": "nx serve server",
    "infra": "docker compose -p spark -f infrastructure/docker-compose.yaml up",
    "hasura": "cd infrastructure/hasura && hasura metadata reload && hasura console --console-port=9697 --admin-secret=jijikos",
    "reset-infra": "docker compose -p spark -f infrastructure/docker-compose.yaml down -v",
    "update-schema": "cd infrastructure/hasura && hasura migrate apply && hasura metadata apply",
    "seed": "cd infrastructure/hasura && hasura seed apply",
    "codegen": "cd apps/ui && graphql-codegen --watch",
    "firebase": "nx run-many --targets=serve --projects=functions,firebase-admin --parallel=2 --output-style=stream",
    "firebase:deploy": "firebase deploy --only functions",
    "firebase:shell": "firebase functions:shell"
  },
